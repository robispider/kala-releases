---
import evidence from '../../../docs/reference/published-layout-snapshot-v1.json';
import latest from '../data/latest-release.json';
const { locale = 'en' } = Astro.props;
const bn = locale === 'bn';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (route: string) => `${base}/${locale}/${route}/`;
const layouts = [
  { name: bn ? 'কালা ঝড়' : 'Kala Jhor', route: 'layouts/kala-jhor', kind: bn ? 'আগের অক্ষর অনুযায়ী স্বরবর্ণ' : 'CONTEXT VOWELS', description: bn ? 'একই অক্ষর চেপে কার বা পূর্ণ স্বরবর্ণ লিখুন। আগের অক্ষর অনুযায়ী কালা সঠিক রূপটি বেছে নেয়।' : 'One vowel key gives a sign after a consonant and a full vowel elsewhere. Fewer extra steps for vowels.', recipe: 'F X L → আমি' },
  { name: bn ? 'কালা গতি' : 'Kala Goti', route: 'layouts/kala-goti', kind: bn ? 'হসন্ত + কারে পূর্ণ স্বরবর্ণ' : 'HASANT + SIGN VOWELS', description: bn ? 'গবেষণায় বেছে নেওয়া অক্ষরের অবস্থান। পূর্ণ স্বরবর্ণের জন্য হসন্তের পর কার লিখুন।' : 'Research-designed key positions with a consistent hasant + vowel-sign recipe for full vowels.', recipe: 'K F X C → আমি' },
  { name: bn ? 'ফোনেটিক টাইপিং' : 'Phonetic typing', route: 'layouts/avro-unijoy', kind: bn ? 'রোমান হরফে বাংলা' : 'A FAMILIAR START', description: bn ? 'রোমান হরফে বাংলা শব্দের উচ্চারণ লিখুন। পরিচিত পদ্ধতিতে শুরু করে চাইলে পরে ফিক্সড লেআউট শিখুন।' : 'Spell Bangla words in Roman letters. Start with what you know and explore fixed layouts when you are ready.', recipe: 'ami → আমি' },
];
const links = [
  { title: bn ? 'প্রথম শব্দটি লিখুন' : 'Write your first word', body: bn ? 'ইনস্টল করুন, পছন্দের লেআউটটিতে নিজের অ্যাপে বাংলা লিখুন।' : 'Install, choose a layout, and turn Bangla on in your everyday app.', route: 'guide/installation', number: '01' },
  { title: bn ? 'বানান দেখুন, সংশোধন বেছে নিন' : 'Turn on writing assistance', body: bn ? 'অটোকরেকশন, সাজেশন ও বানানের চিহ্ন নিজের প্রয়োজন অনুযায়ী চালু করুন।' : 'Choose autocorrection, suggestions, and spelling marks to suit your work.', route: 'guide/corrections', number: '02' },
  { title: bn ? 'নিজের শব্দ ও শর্টকাট রাখুন' : 'Keep your words and shortcuts', body: bn ? 'নাম ও পছন্দের বানান অপরিবর্তিত রাখুন। বারবার লেখা কথার জন্য শর্টকাট সংরক্ষণ করুন।' : 'Protect names and preferred spellings. Save shortcuts for phrases you use often.', route: 'guide/personal-words', number: '03' },
];
const searchRuns = evidence.finalLayouts.KalaJhor.search.independentRuns;
---
<div class="kala-home">
  <div class="release-note">
    <span class="status-dot" aria-hidden="true"></span>
    <span>{bn ? 'Windows x64 · বিনা মূল্যে ব্যবহার ও বিতরণ' : 'Windows x64 · Free to use and distribute'}</span>
    <a class="latest-release" href={latest.releaseUrl}>{bn ? 'সর্বশেষ রিলিজ' : 'Latest release'} {latest.tag} · {latest.label[bn ? 'bn' : 'en']}</a>
    <a href={href('release-status')}>{bn ? 'রিলিজের অবস্থা' : 'Release status'} ↗</a>
  </div>
  <section class="home-section" aria-labelledby="assistance-title">
    <div class="section-heading">
      <p class="eyebrow">{bn ? 'একসঙ্গে লেখার তিন সহায়তা' : 'THREE WAYS TO HELP YOU WRITE'}</p>
      <h2 id="assistance-title">{bn ? 'টাইপ করুন। বানান যাচাই করুন। ভুল সংশোধন করুন।' : 'Type. Spellcheck. Autocorrect.'}</h2>
      <p>{bn ? 'যে অ্যাপে কাজ করছেন, সেখানেই বাংলা লেখার সহায়তা পান। আলাদা প্লাগইন ইনস্টল করতে হয় না।' : 'Bangla writing assistance in the app you are already using. No separate plugin to install.'}</p>
    </div>
    <div class="feature-grid">
      <article class="feature-card">
        <span class="feature-number">01 / {bn ? 'টাইপিং' : 'TYPE'}</span>
        <h3>{bn ? 'নিজের অ্যাপেই বাংলা লিখুন' : 'Write where you work'}</h3>
        <p>{bn ? 'ফোনেটিক বা ফিক্সড লেআউট বেছে নিন। ফিজিক্যাল ও অন-স্ক্রিন কিবোর্ডে একই লেআউট ও সংশোধন সেটিংস ব্যবহার করুন।' : 'Choose phonetic or fixed keys. Your physical and on-screen keyboards share the same layout and correction settings.'}</p>
        <a class="text-link" href={href('guide/typing')}>{bn ? 'অন্য অ্যাপে লেখার ধাপ' : 'Type in another app'} →</a>
      </article>
      <article class="feature-card featured">
        <span class="feature-number">02 / {bn ? 'স্পেলচেক' : 'SPELLCHECK'}</span>
        <h3>{bn ? 'লিখতে লিখতেই বানান দেখুন' : 'Catch spelling errors as you type'}</h3>
        <p>{bn ? 'বানানের চিহ্ন চালু করলে সম্ভাব্য ভুল চোখে পড়ে। সাজেশন থেকে বিকল্প বানান দেখুন এবং উপযুক্তটি বেছে নিন। লেখা অন্য কোথাও কপি করে নেওয়ার প্রয়োজন নেই।' : 'Enable spelling marks to spot likely errors. Review suggestions and choose the spelling you want, without copying your writing to a separate editor.'}</p>
        <div class="mark-legend"><span class="mark-error">{bn ? 'সম্ভাব্য ভুল' : 'Likely error'}</span><span class="mark-confused">{bn ? 'সঠিক, তবে প্রায়ই গুলিয়ে যায়' : 'Correct, often confused'}</span><span class="mark-corrected">{bn ? 'স্বয়ংক্রিয়ভাবে সংশোধিত' : 'Autocorrected'}</span></div>
        <a class="text-link" href={href('guide/corrections')}>{bn ? 'স্পেলচেক চালু করার ধাপ' : 'Set up spellchecking'} →</a>
      </article>
      <article class="feature-card">
        <span class="feature-number">03 / {bn ? 'অটোকরেকশন' : 'AUTOCORRECT'}</span>
        <h3>{bn ? 'পরিচিত ভুলে কম বাধা' : 'Keep common mistakes from slowing you down'}</h3>
        <p>{bn ? 'Space চাপলে কালা চালু থাকা নিয়ম অনুযায়ী শব্দ সংশোধন করে। বানান নিজে নিয়ন্ত্রণ করতে চাইলে অটোকরেকশন বন্ধ করুন বা ব্যক্তিগত শব্দ সংরক্ষণ করুন।' : 'Finish a word with Space and Kala applies enabled word-correction rules. Turn autocorrection off or protect a personal spelling whenever you prefer.'}</p>
        <div class="correction-example"><span>{bn ? 'Space চাপলে' : 'At Space'}</span><span>অংশিদার → <strong>অংশীদার</strong></span></div>
        <a class="text-link" href={href('guide/personal-words')}>{bn ? 'নিজের বানান সংরক্ষণ করুন' : 'Protect your spellings'} →</a>
      </article>
    </div>
    <div class="app-strip" aria-label={bn ? 'যেসব অ্যাপে লিখতে পারেন' : 'Everyday writing destinations'}><span>Word</span><span>{bn ? 'ব্রাউজারের এডিটর' : 'Browser editors'}</span><span>Notepad</span><span>Paint</span><span>Photoshop</span><span>{bn ? 'ডেস্কটপ ব্যবসায়িক অ্যাপের ফর্ম' : 'Desktop business forms'}</span></div>
    <p class="small-note">{bn ? 'সাধারণ সম্পাদনাযোগ্য টেক্সট ফিল্ডে লিখুন; Paint ও Photoshop-এ টেক্সট টুল চালু করুন। বানানের চিহ্ন ও সাজেশন প্রয়োগের সুবিধা অ্যাপের টেক্সট ও কার্সরের তথ্যের ওপর নির্ভর করে।' : 'Use an ordinary editable text field; activate the text tool in Paint or Photoshop. Spelling marks and suggestion replacement depend on the app’s text and caret support.'} <a href={href('release-status')}>{bn ? 'প্রাপ্যতা ও সীমাবদ্ধতা' : 'Availability and limits'} →</a></p>
  </section>
  <section class="home-section" aria-labelledby="layouts-title">
    <div class="section-heading"><p class="eyebrow">{bn ? 'বাংলার জন্য কালার নিজস্ব লেআউট' : 'ORIGINAL LAYOUTS FOR BANGLA'}</p>
      <h2 id="layouts-title">{bn ? 'ফিক্সড লেআউটে হাতের অভ্যাস গড়ে তুলুন।' : 'Build a rhythm with fixed keys.'}</h2>
      <p>{bn ? 'প্রতিটি শব্দ রোমান হরফে বানান করে লেখার বদলে সরাসরি বাংলা অক্ষর টাইপ করুন। কালা ঝড় ও কালা গতি তৈরি হয়েছে আঙুলের পরিশ্রম কমানোর লক্ষ্য নিয়ে।' : 'Type Bangla letters directly instead of spelling every word in Roman letters. Kala Jhor and Kala Goti were designed to reduce modeled finger effort.'}</p>
    </div>
    <div class="layout-grid">{layouts.map((layout) => <a class="layout-card" href={href(layout.route)}><span class="layout-kind">{layout.kind}</span><h3>{layout.name}</h3><p>{layout.description}</p><div class="recipe"><code>{layout.recipe}</code><span aria-hidden="true">↗</span></div></a>)}</div>
    <p class="small-note">{bn ? 'কালা ঝড় ও কালা গতি কোথা থেকে এল?' : 'Where did Kala Jhor and Kala Goti come from?'} <a href={`https://robispider.github.io/kala-layout/${locale}/how/`}>{bn ? 'গবেষণার পদ্ধতি ও যাচাই পড়ুন' : 'Read the research method and checks'} ↗</a> · <a href={`https://robispider.github.io/kala-layout/${locale}/`}>{bn ? 'গবেষণার ফল দেখুন' : 'Explore the research results'} ↗</a></p>
    <p class="layout-license"><span>CC0</span>{bn ? 'ঝড় ও গতির নিজস্ব লেআউটের ম্যাপ ব্যবহার করুন, বদলান, শেয়ার করুন—অনুমতি বা রয়্যালটি ছাড়াই।' : 'Jhor and Goti’s original layout maps are yours to use, adapt, and share—without permission or royalties.'} <a href={href('layout-license')}>{bn ? 'লাইসেন্সের শর্ত' : 'Read the dedication'} →</a></p>
    <div class="import-note"><div><h3>{bn ? 'নিজের পছন্দের লেআউটও ব্যবহার করুন।' : 'Bring a layout of your own.'}</h3><p>{bn ? 'সমর্থিত ফরম্যাটের লেআউট ইমপোর্ট করুন, অক্ষরের ম্যাপ দেখুন এবং নিজের অ্যাপে লিখে পরীক্ষা করুন। কালার সংশোধন সেটিংস ইমপোর্ট করা লেআউটেও প্রযোজ্য।' : 'Import a layout in a supported format, inspect its keys, and try it in your apps. Kala’s correction settings also apply to imported layouts.'}</p></div><a class="text-link" href={href('guide/layouts')}>{bn ? 'লেআউট ইমপোর্ট' : 'Import a layout'} →</a></div>
    <p class="small-note">{bn ? 'ফিক্সড লেআউটের উদাহরণে ইংরেজি অক্ষরগুলো কিবোর্ডের অবস্থান বোঝায়। Shift উল্লেখ না থাকলে শুধু অক্ষর চাপুন।' : 'Fixed-layout examples name physical key positions. Use unshifted keys unless a recipe says Shift.'}</p>
  </section>
  <section class="home-section"><p><a href="https://robispider.github.io/kala-typing-master/">{bn ? 'ব্রাউজারে গতি ও ঝড় অনুশীলন করুন' : 'Practise Goti and Jhor in your browser'} ↗</a> · <a href="https://www.facebook.com/kalabanglakeyboard">Facebook ↗</a></p></section>
  <section class="home-section research-section" aria-labelledby="research-title">
    <div><p class="eyebrow">BANGLA-DH PURE</p><h2 id="research-title">{bn ? 'নির্দিষ্ট মডেলে হিসাব করে তৈরি।' : 'Designed with evidence you can inspect.'}</h2>
      <p class="section-body">{bn ? 'Colemak Mod-DH মডেল থেকে বাংলার জন্য আঙুলের পরিশ্রমের হিসাব তৈরি করা হয়েছে। বড় বাংলা টেক্সট ডেটাসেটে কম্পিউটার সার্চের পর আলাদা রাখা টেক্সটে ফল যাচাই করা হয়েছে। রেকর্ড করা আটটি ফিক্সড লেআউটের তুলনায় ঝড় প্রথম ও গতি দ্বিতীয়।' : 'An explicit finger-effort model builds on Colemak Mod-DH. Computer searches used large Bangla text datasets, then the results were checked on held-out text. Jhor ranks first and Goti second in the recorded eight-layout effort comparison.'}</p>
      <div class="inline-links"><a href={href('research')}>{bn ? 'পদ্ধতি, ফল ও গাণিতিক প্রমাণের পরিধি পড়ুন' : 'Explore the method, results, and mathematical scope'} →</a><a href={`https://robispider.github.io/kala-layout/${bn ? 'bn' : 'en'}/`}>{bn ? 'নিজে আবার চালান বা চ্যালেঞ্জ করুন (kala-layout)' : 'Repeat the search or take the challenge (kala-layout)'} ↗</a><a href="https://github.com/robispider/kala-layout">{bn ? 'গবেষণার রিপোজিটরি' : 'Research repository'} ↗</a></div>
    </div>
    <div class="research-facts"><div><strong>{searchRuns}</strong><span>{bn ? 'প্রতি লেআউটের জন্য স্বতন্ত্র সার্চ রান' : 'Independent search runs per layout'}</span></div><div><strong>19,989,555</strong><span>{bn ? 'সার্চে ব্যবহার না করা টেক্সটের চলমান শব্দ দিয়ে মূল্যায়ন' : 'Running word tokens in held-out evaluation text'}</span></div><div><strong>{bn ? '৩টি' : '3'}</strong><span>{bn ? 'আলাদা মূল্যায়ন সেট: উইকিপিডিয়া, সংবাদপত্র ও নতুন সংবাদ' : 'Evaluation sets: Wikipedia, newspaper, and unseen news'}</span></div></div>
    <p class="research-note">{bn ? 'গাণিতিক সীমা ও নির্দিষ্ট পরিধির প্রমাণ গবেষণার আগের লেআউটগুলোর জন্য আছে। বর্তমান ঝড় ও গতি সার্চে পাওয়া সেরা; সব সম্ভাব্য লেআউটের মধ্যে সেরা হওয়ার প্রমাণ নেই। মডেলে কম পরিশ্রম মানুষের গতি বৃদ্ধির মাপ নয়। গতি, স্বাচ্ছন্দ্য ও শেখার সময়ের পরীক্ষা এখনো বাকি।' : 'Mathematical bounds and scoped proofs exist for earlier research layouts. Current Jhor and Goti are best found, with no global optimality proof. Lower modeled effort is not a measured human speed gain; speed, comfort, and learning-time trials remain pending.'}</p>
  </section>
  <section class="home-section learn-section" aria-labelledby="learn-title">
    <div><p class="eyebrow">{bn ? 'কালার সঙ্গে ফিক্সড লেআউট শিখুন' : 'LEARN WITH KALA'}</p><h2 id="learn-title">{bn ? 'অক্ষর চেনা থেকে সাবলীল টাইপিংয়ের পথে।' : 'From finding the keys to finding your flow.'}</h2>
      <p class="section-body">{bn ? 'নতুন লেআউটের শুরুতে একা নন। Learn মডিউলে নিজের শুরুর অবস্থান বেছে নিন, ছোট দৈনিক সেশনে অনুশীলন করুন এবং কোন অক্ষরে আরও চর্চা দরকার দেখুন। ফোনেটিক থেকে ফিক্সড লেআউটে যেতে চাইলে ধাপে ধাপে অভ্যাস গড়ে তুলুন।' : 'A new layout comes with a way to learn it. Choose your starting point, practise in short daily sessions, and see which keys need more work. Build the habit step by step as you move from phonetic entry to fixed-layout typing.'}</p>
      <div class="inline-links"><a href={href('guide/learning')}>{bn ? 'Learn দিয়ে শুরু করুন' : 'Start learning'} →</a><a href={href('layouts/kala-jhor')}>{bn ? 'ঝড়ের অক্ষরের ম্যাপ' : 'Jhor key map'} →</a><a href={href('layouts/kala-goti')}>{bn ? 'গতির অক্ষরের ম্যাপ' : 'Goti key map'} →</a></div>
    </div>
    <aside class="learn-preview"><span class="layout-kind">{bn ? 'রিলিজের সঙ্গে Learn মডিউল' : 'LEARN INCLUDED IN THE RELEASE'}</span><h3>{bn ? 'দিনে ৫, ১০ বা ১৫ মিনিট।' : '5, 10, or 15 minutes a day.'}</h3>
