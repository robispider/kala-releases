---
import evidence from '../../../docs/reference/layout-research-snapshot.json';
const { locale = 'en' } = Astro.props;
const bn = locale === 'bn';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (route: string) => `${base}/${locale}/${route}/`;
const layouts = [
  { name: 'Avro Phonetic', route: 'layouts/avro-unijoy', kind: bn ? 'রোমান বানান' : 'Roman spelling', description: bn ? 'ইংরেজি অক্ষরে শব্দের উচ্চারণ লিখুন; Kala তা বাংলায় রূপ দেয়।' : 'Spell words in Roman letters and watch them become Bangla.', recipe: 'ami → আমি' },
  { name: 'UniJoy', route: 'layouts/avro-unijoy', kind: bn ? 'পরিচিত স্থির বিন্যাস' : 'Familiar fixed keys', description: bn ? 'UniJoy-এর পরিচিত বাংলা কী ও স্বরবর্ণ লেখার পদ্ধতি।' : 'The familiar Bangla key map and hasant + vowel-sign method.', recipe: 'G F M D → আমি' },
  { name: bn ? 'Kala ঝড়' : 'Kala Jhor', route: 'layouts/kala-jhor', kind: bn ? 'প্রসঙ্গ অনুযায়ী স্বরবর্ণ' : 'Context vowels', description: bn ? 'আগের বর্ণ দেখে একই স্বর-কী কার বা পূর্ণ স্বরবর্ণ দেয়।' : 'One vowel key. The current word decides sign or full vowel.', recipe: 'F X L → আমি' },
  { name: bn ? 'Kala গতি' : 'Kala Goti', route: 'layouts/kala-goti', kind: bn ? 'UniJoy-ধাঁচের স্বরবর্ণ' : 'UniJoy-style vowels', description: bn ? 'গবেষণায় সাজানো নতুন কী-অবস্থান, পরিচিত হসন্ত + কার পদ্ধতি।' : 'Research-designed key positions, familiar hasant + sign entry.', recipe: 'K F X C → আমি' },
];
const links = [
  { title: bn ? 'প্রথমবার শুরু করুন' : 'Get your first word right', body: bn ? 'ডাউনলোড, ইনস্টল ও অন্য অ্যাপে বাংলা চালুর ধাপ।' : 'Download, install, and turn Bangla on in another app.', route: 'guide/installation', number: '01' },
  { title: bn ? 'লেখার সহায়তা বেছে নিন' : 'Choose your writing help', body: bn ? 'সংশোধন, বিকল্প বানান ও বানানের চিহ্ন—আলাদা নিয়ন্ত্রণ।' : 'Corrections, alternatives, and spelling marks, each with its own control.', route: 'guide/corrections', number: '02' },
  { title: bn ? 'নিজের শব্দ সংরক্ষণ করুন' : 'Make Kala your own', body: bn ? 'নাম, পছন্দের বানান ও শর্টকাট নিজের কম্পিউটারে রাখুন।' : 'Keep names, preferred spellings, and shortcuts on your computer.', route: 'guide/personal-words', number: '03' },
];
const board = evidence.finalRoundedLeaderboard.entries;
const maximum = Math.max(...board.map((row) => row.average));
---
<div class="kala-home">
  <div class="release-note">
    <span class="status-dot" aria-hidden="true"></span>
    <span>{bn ? 'v0.1.0-alpha.1 · Windows x64 · বিনা মূল্যে ব্যবহার ও বিতরণ' : 'v0.1.0-alpha.1 · Windows x64 · Free to use and distribute'}</span>
    <a href={href('release-status')}>{bn ? 'সংস্করণের অবস্থা' : 'Release status'} <span aria-hidden="true">↗</span></a>
  </div>
  <section class="home-section" aria-labelledby="layouts-title">
    <div class="section-heading">
      <p class="eyebrow">{bn ? 'আপনার লেখার ধরন' : 'YOUR WAY TO TYPE'}</p>
      <h2 id="layouts-title">{bn ? 'চারটি বিন্যাস। আপনার পছন্দ।' : 'Four layouts. Your choice.'}</h2>
      <p>{bn ? 'ফিজিক্যাল ও অন-স্ক্রিন কিবোর্ডে একই বিন্যাস ও সেটিংস ব্যবহার করুন।' : 'Use the same layout and settings on your physical and on-screen keyboards.'}</p>
    </div>
    <div class="layout-grid">
      {layouts.map((layout) => <a class="layout-card" href={href(layout.route)}>
        <span class="layout-kind">{layout.kind}</span>
        <h3>{layout.name}</h3>
        <p>{layout.description}</p>
        <div class="recipe"><code>{layout.recipe}</code><span aria-hidden="true">↗</span></div>
      </a>)}
    </div>
    <p class="small-note">{bn ? 'স্থির বিন্যাসের উদাহরণে ইংরেজি অক্ষরগুলো ফিজিক্যাল কী-এর অবস্থান বোঝায়; Shift বলা না থাকলে সাধারণ কী চাপুন।' : 'Fixed-layout examples name physical key positions. Use unshifted keys unless a recipe says Shift.'}</p>
  </section>
  <section class="home-section guide-section" aria-labelledby="guide-title">
    <div class="section-heading">
      <p class="eyebrow">{bn ? 'ধাপে ধাপে নির্দেশিকা' : 'A GUIDE FOR EVERYDAY USE'}</p>
      <h2 id="guide-title">{bn ? 'ইনস্টল থেকে নিজের মতো ব্যবহার।' : 'From installation to your own routine.'}</h2>
    </div>
    <div class="guide-grid">
      {links.map((link) => <a class="guide-card" href={href(link.route)}>
        <span class="guide-number">{link.number}</span>
        <h3>{link.title}</h3><p>{link.body}</p>
        <span class="text-link">{bn ? 'ধাপগুলো দেখুন' : 'Follow the steps'} <span aria-hidden="true">→</span></span>
      </a>)}
    </div>
    <a class="all-guides" href={href('guide')}>{bn ? 'সব ফিচার ও মডিউলের নির্দেশিকা' : 'Explore every feature and module'} <span aria-hidden="true">→</span></a>
  </section>
  <section class="home-section research-section" aria-labelledby="research-title">
    <div class="research-copy">
      <p class="eyebrow">BANGLA-DH PURE</p>
      <h2 id="research-title">{bn ? 'মডেল আছে। পরীক্ষার ফলও আছে।' : 'Designed with a model. Checked against text.'}</h2>
      <p>{bn ? 'Kala ঝড় ও Kala গতি তৈরি হয়েছে একটি নির্দিষ্ট আঙুল-পরিশ্রম মডেল, বড় বাংলা পাঠসংগ্রহ ও কম্পিউটার অনুসন্ধান দিয়ে।' : 'Kala Jhor and Kala Goti were built with an explicit finger-effort model, large Bangla corpora, and computer search.'}</p>
      <div class="research-stats">
        <div><strong>35.7%</strong><span>{bn ? 'ঝড়: UniJoy-এর চেয়ে কম মডেল-হিসাবের পরিশ্রম' : 'Jhor: lower modeled effort than UniJoy'}</span></div>
        <div><strong>34.1%</strong><span>{bn ? 'গতি: UniJoy-এর চেয়ে কম মডেল-হিসাবের পরিশ্রম' : 'Goti: lower modeled effort than UniJoy'}</span></div>
      </div>
      <a class="text-link" href={href('research')}>{bn ? 'পদ্ধতি, তুলনা ও সীমা পড়ুন' : 'Read the method, comparison, and limits'} <span aria-hidden="true">→</span></a>
    </div>
    <div class="effort-board">
      <div class="board-heading"><h3>{bn ? 'গড় পরিশ্রম · J1' : 'Average effort · J1'}</h3><span>{bn ? 'কম হলে ভালো' : 'Lower is better'}</span></div>
      <ol>
        {board.map((row) => <li class:list={{ 'kala-row': row.kind === 'kala' }}>
          <div class="bar-label"><span>{bn ? row.nameBn : row.name}</span><strong>{row.average.toFixed(4)}</strong></div>
          <div class="bar-track" aria-hidden="true"><span style={`width:${row.average / maximum * 100}%`}></span></div>
        </li>)}
      </ol>
      <p>{bn ? 'উইকিপিডিয়া, সংবাদপত্র ও আগে না-দেখা সংবাদে রেকর্ড করা held-out ফলের সমান ওজনের গড়।' : 'Equal-weight average of recorded held-out Wikipedia, newspaper, and unseen-news results.'}</p>
    </div>
    <p class="research-note">{bn ? 'এগুলো মডেলের ফল। মানুষের টাইপিং-গতি, স্বাচ্ছন্দ্য ও শেখার সময়ের পরীক্ষা এখনো বাকি। বর্তমান বিন্যাসগুলো অনুসন্ধানে পাওয়া সেরা; সর্বজনীন সর্বোত্তম প্রমাণিত নয়।' : 'These are model results. Human speed, comfort, and learning-time trials remain pending. The current layouts are best found, without a global optimality proof.'}</p>
  </section>
  <section class="home-section credit-section" aria-labelledby="credit-title">
    <div>
      <p class="eyebrow">{bn ? 'কৃতজ্ঞতা ও অবদান' : 'CREDIT WHERE IT BELONGS'}</p>
      <h2 id="credit-title">{bn ? 'ধন্যবাদ, OmicronLab।' : 'Thank you, OmicronLab.'}</h2>
      <p>{bn ? 'Kala-র Avro Phonetic বাস্তবায়ন Avro-র বিন্যাস ও নিয়ম ব্যবহার করে তার টাইপিং আচরণ অনুকরণ করে। Avro Keyboard ও Avro Phonetic তৈরি এবং ভাগ করে নেওয়ার জন্য OmicronLab ও অবদানকারীদের ধন্যবাদ।' : 'Kala’s Avro Phonetic implementation uses Avro’s layout and rules to mimic its typing behavior. Thank you to OmicronLab and the contributors for creating and sharing Avro Keyboard and Avro Phonetic.'}</p>
      <div class="credit-links"><a href="https://www.omicronlab.com/">OmicronLab ↗</a><a href="https://github.com/omicronlab/Avro-Keyboard">Avro Keyboard ↗</a></div>
    </div>
    <div class="free-note">
      <h3>{bn ? 'বিনা মূল্যে, আপনার কম্পিউটারে।' : 'Free, and on your computer.'}</h3>
      <p>{bn ? 'Kala বিনা মূল্যে ব্যবহার ও বিতরণ করা যায়। অ্যাপের সোর্স কোড ভবিষ্যতে প্রকাশ করা হবে। ব্যক্তিগত শব্দ ও অ্যাপের রিপোর্ট Kala নিজে আপলোড করে না।' : 'Kala is free to use and distribute. The application source code will be available in the future. Kala does not automatically upload personal words or app reports.'}</p>
      <a href={href('guide/settings')}>{bn ? 'গোপনীয়তা ও সহায়তা' : 'Privacy and support'} →</a>
    </div>
  </section>
</div>
<style>
  .kala-home { --home-border: var(--sl-color-gray-5); line-height: 1.7; }
  .kala-home :is(h2,h3,p) { margin: 0; }
  .release-note { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; padding: 1rem 0; border-block: 1px solid var(--home-border); font-size: .83rem; color: var(--sl-color-gray-2); }
  .release-note a { margin-left: auto; font-weight: 650; color: var(--sl-color-text-accent); }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sl-color-accent); }
  .home-section { padding-block: 3.2rem; }
  .eyebrow { font-size: .72rem; letter-spacing: .12em; color: var(--sl-color-text-accent); font-weight: 750; margin-bottom: .65rem !important; }
  h2 { font-size: clamp(1.65rem,3vw,2.2rem); line-height: 1.3; letter-spacing: -.035em; color: var(--sl-color-white); }
  .section-heading > p:last-child { margin-top: .8rem; color: var(--sl-color-gray-2); }
  .layout-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .8rem; margin-top: 1.7rem; }
  .layout-card, .guide-card { text-decoration: none; color: var(--sl-color-text); border: 1px solid var(--home-border); border-radius: 16px; padding: 1.2rem; display: flex; flex-direction: column; transition: border-color .15s, background .15s; }
  .layout-card:hover, .guide-card:hover { border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .layout-kind { font-size: .72rem; color: var(--sl-color-gray-2); }
  .layout-card h3 { margin-block: .65rem .7rem; font-size: 1.15rem; letter-spacing: -.025em; }
  .layout-card p { font-size: .86rem; color: var(--sl-color-gray-2); flex: 1; }
  .recipe { margin-top: 1.5rem; display: flex; align-items: center; gap: .35rem; font-size: .78rem; }
  .recipe code { padding: .25rem .4rem; border-radius: 6px; background: var(--sl-color-gray-6); font-family: var(--sl-font); }
  .recipe > span { margin-left: auto; }
  .small-note { font-size: .78rem; color: var(--sl-color-gray-3); margin-top: .85rem !important; }
  .guide-section { border-top: 1px solid var(--home-border); }
  .guide-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 1.7rem; }
  .guide-number { font-size: .85rem; font-weight: 750; color: var(--sl-color-text-accent); margin-bottom: 1rem; }
  .guide-card h3 { font-size: 1.1rem; margin-bottom: .65rem; }
  .guide-card p { font-size: .88rem; flex: 1; color: var(--sl-color-gray-2); }
  .text-link { font-size: .86rem; font-weight: 650; color: var(--sl-color-text-accent); }
  .guide-card .text-link { margin-top: 1.2rem; }
  .all-guides { display: inline-block; margin-top: 1.2rem; font-size: .9rem; font-weight: 650; }
  .research-section { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; border-top: 1px solid var(--home-border); }
  .research-copy > p:not(.eyebrow) { margin-block: 1rem; color: var(--sl-color-gray-2); }
  .research-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-block: 1.8rem; }
  .research-stats strong { display: block; font-size: clamp(2rem,4vw,2.8rem); letter-spacing: -.055em; color: var(--sl-color-text-accent); }
  .research-stats span { display: block; max-width: 22ch; font-size: .8rem; color: var(--sl-color-gray-2); }
  .effort-board { border: 1px solid var(--home-border); border-radius: 16px; padding: 1.3rem; background: var(--sl-color-gray-6); }
  .board-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem; }
  .board-heading h3 { font-size: .95rem; }
  .board-heading > span { font-size: .7rem; color: var(--sl-color-gray-2); }
  .effort-board ol { list-style: none; padding: 0; margin: 1.1rem 0; }
  .effort-board li + li { margin-top: .65rem; }
  .bar-label { display: flex; justify-content: space-between; align-items: baseline; font-size: .75rem; gap: .6rem; }
  .bar-label strong { font-variant-numeric: tabular-nums; font-size: .72rem; }
  .bar-track { margin-top: .2rem; height: 5px; background: var(--sl-color-gray-5); border-radius: 5px; }
  .bar-track > span { display: block; height: 100%; background: var(--sl-color-gray-3); border-radius: inherit; }
  .kala-row .bar-track > span { background: var(--sl-color-accent); }
  .kala-row .bar-label { color: var(--sl-color-text-accent); font-weight: 700; }
  .effort-board p { font-size: .7rem; color: var(--sl-color-gray-2); }
  .research-note { grid-column: 1 / -1; padding: 1rem; border-left: 3px solid var(--sl-color-accent); border-radius: 0 8px 8px 0; background: var(--sl-color-gray-6); color: var(--sl-color-gray-2); font-size: .82rem; }
  .credit-section { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.2rem; border-top: 1px solid var(--home-border); }
  .credit-section p:not(.eyebrow) { font-size: .9rem; color: var(--sl-color-gray-2); margin-top: .9rem; }
  .credit-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; font-size: .85rem; }
  .free-note { background: var(--sl-color-gray-6); border-radius: 16px; padding: 1.5rem; }
  .free-note h3 { font-size: 1.15rem; }
  .free-note a { display: inline-block; margin-top: 1rem; font-size: .85rem; font-weight: 650; }
  :global(html[lang='bn']) :is(h2,h3) { letter-spacing: 0; line-height: 1.5; }
  @media (max-width: 70rem) { .layout-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 45rem) { .research-section, .credit-section { grid-template-columns: 1fr; } .guide-grid { grid-template-columns: 1fr; } .home-section { padding-block: 2rem; } .release-note a { margin-left: 0; } }
  @media (max-width: 26rem) { .layout-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .layout-card, .guide-card { transition: none; } }
</style>
